# ---------------------------------------------------------------------------
# PlatformIO
# ---------------------------------------------------------------------------
# Build output, downloaded frameworks, toolchains and per-project libraries.
# Regenerated by `pio run`; can be hundreds of MB.
.pio/
.pioenvs/
.piolibdeps/
compile_commands.json

# ---------------------------------------------------------------------------
# ESP-IDF build output / generated files
# ---------------------------------------------------------------------------
build/
managed_components/
/sdkconfig
sdkconfig.old
sdkconfig.*.old
*.map
*.lst

# NOTE: sdkconfig.esp32doit-devkit-v1 is intentionally NOT ignored. It is this
# project's board configuration and cannot be regenerated byte-for-byte.
# (If you later switch to `sdkconfig.defaults`, ignore sdkconfig.* instead.)

# ---------------------------------------------------------------------------
# VS Code - PlatformIO-generated files
# ---------------------------------------------------------------------------
# These are machine-specific and regenerated on project open.
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.vscode/*.log

# Kept tracked on purpose (useful to share with the team):
#   .vscode/extensions.json   -> recommends the PlatformIO IDE extension
#   .vscode/settings.json     -> workspace settings

# ---------------------------------------------------------------------------
# C/C++ language-server caches
# ---------------------------------------------------------------------------
.cache/
.clangd/
.ccls-cache/

# Object files / dependency files produced outside .pio
*.o
*.d

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak
*.orig

# ---------------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Logs and Python caches (helper scripts)
# ---------------------------------------------------------------------------
*.log
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Deliberately NOT ignored (project content):
#   src/, include/, lib/, test/   source code
#   data/                         SPIFFS/LittleFS image content (uploadfs)
#   platformio.ini, CMakeLists.txt
#   sdkconfig.esp32doit-devkit-v1
# ---------------------------------------------------------------------------
